{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientEnvelope",
  "description": "Сообщение клиента. `id` — номер команды в рамках соединения, сервер подтверждает его `ack`.\nПри повторной отправке после переподключения используется тот же `id` и тело:\nвсе команды идемпотентны.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "v": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "description": "Первое сообщение. `last_seq` — последний обработанный клиентом номер события матча.",
      "type": "object",
      "properties": {
        "last_seq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "match_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "Heartbeat и оценка смещения часов: `c` — время клиента, мс.",
      "type": "object",
      "properties": {
        "c": {
          "type": "number",
          "format": "double"
        },
        "type": {
          "type": "string",
          "const": "ping"
        }
      },
      "required": [
        "type",
        "c"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "queue_join"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "queue_leave"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "song_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "room_create"
        }
      },
      "required": [
        "type",
        "song_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "room_join"
        }
      },
      "required": [
        "type",
        "code"
      ]
    },
    {
      "type": "object",
      "properties": {
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "const": "accept"
        }
      },
      "required": [
        "type",
        "match_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "const": "decline"
        }
      },
      "required": [
        "type",
        "match_id"
      ]
    },
    {
      "description": "Эталон и минусовка загружены, микрофон разрешён, AudioContext активирован.",
      "type": "object",
      "properties": {
        "algorithm_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "song_version": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "ready"
        }
      },
      "required": [
        "type",
        "match_id",
        "song_version",
        "algorithm_version"
      ]
    },
    {
      "description": "Точки канонической кривой с индекса `from`: десятые доли полутона или null (пауза).",
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "points": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int16",
            "maximum": 32767,
            "minimum": -32768
          }
        },
        "type": {
          "type": "string",
          "const": "perf"
        }
      },
      "required": [
        "type",
        "match_id",
        "from",
        "points"
      ]
    },
    {
      "description": "Клиент отправил все точки: `count` — длина кривой.",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "const": "finish"
        }
      },
      "required": [
        "type",
        "match_id",
        "count"
      ]
    },
    {
      "type": "object",
      "properties": {
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "const": "leave"
        }
      },
      "required": [
        "type",
        "match_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "const": "rematch"
        }
      },
      "required": [
        "type",
        "match_id"
      ]
    }
  ],
  "required": [
    "v",
    "id"
  ]
}
