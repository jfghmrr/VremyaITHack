{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerEnvelope",
  "description": "Сообщение сервера. `seq` есть у событий матча: важные события доставляются\nповторно после переподключения, клиент отбрасывает уже виденные номера.",
  "type": "object",
  "properties": {
    "seq": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "v": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "heartbeat_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "server_time": {
          "type": "number",
          "format": "double"
        },
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "user_id",
        "name",
        "server_time",
        "heartbeat_ms"
      ]
    },
    {
      "type": "object",
      "properties": {
        "c": {
          "type": "number",
          "format": "double"
        },
        "s": {
          "type": "number",
          "format": "double"
        },
        "type": {
          "type": "string",
          "const": "pong"
        }
      },
      "required": [
        "type",
        "c",
        "s"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ok": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "ack"
        }
      },
      "required": [
        "type",
        "id",
        "ok"
      ]
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/QueueState"
        },
        "type": {
          "type": "string",
          "const": "queue"
        }
      },
      "required": [
        "type",
        "state"
      ]
    },
    {
      "description": "Состояние матча целиком. Приходит после подключения и при каждом изменении.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "match"
        },
        "view": {
          "$ref": "#/$defs/MatchView"
        }
      },
      "required": [
        "type",
        "view"
      ]
    },
    {
      "description": "Промежуточная кривая соперника для анимации. Может быть пропущена или заменена.",
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "points": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int16",
            "maximum": 32767,
            "minimum": -32768
          }
        },
        "type": {
          "type": "string",
          "const": "opponent"
        }
      },
      "required": [
        "type",
        "match_id",
        "from",
        "points"
      ]
    },
    {
      "description": "Комната: своя (`invite: false`) или приглашение соперника (`invite: true`).\n`rematch_of` — матч, после которого предложен реванш.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "invite": {
          "type": "boolean",
          "default": false
        },
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "description": "Режим комнаты: приглашение на реванш называет его.",
          "$ref": "#/$defs/MatchMode",
          "default": "versus"
        },
        "rematch_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "const": "room"
        }
      },
      "required": [
        "type",
        "match_id",
        "code"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "type",
        "message"
      ]
    }
  ],
  "required": [
    "v"
  ],
  "$defs": {
    "Axes": {
      "type": "object",
      "properties": {
        "coverage": {
          "type": "number",
          "format": "double"
        },
        "intervals": {
          "type": "number",
          "format": "double"
        },
        "rhythm": {
          "type": "number",
          "format": "double"
        },
        "stability": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "intervals",
        "rhythm",
        "stability",
        "coverage"
      ]
    },
    "HardMoment": {
      "type": "object",
      "properties": {
        "end_s": {
          "type": "number",
          "format": "double"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "start_s": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "reason"
      ]
    },
    "MatchMode": {
      "description": "Режим матча. «Кто лучше» (`versus`) — дуэль: оба поют всю песню, побеждает точность.\n«Вместе» (`coop`) — только комната друга: поют по очереди, по строке, общий балл без победителя.",
      "type": "string",
      "enum": [
        "versus",
        "coop"
      ]
    },
    "MatchResult": {
      "type": "object",
      "properties": {
        "players": {
          "description": "Для «Вместе» `score` и `axes` каждого — оценка его партии (только его ходы),\nисход у обоих `draw`: победителя нет.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlayerResult"
          }
        },
        "rated": {
          "type": "boolean"
        },
        "team": {
          "description": "Только «Вместе»: общий балл и партии.",
          "anyOf": [
            {
              "$ref": "#/$defs/TeamResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "technical": {
          "type": "boolean"
        }
      },
      "required": [
        "rated",
        "technical",
        "players"
      ]
    },
    "MatchState": {
      "type": "string",
      "enum": [
        "created",
        "waiting",
        "ready_check",
        "countdown",
        "singing",
        "collecting",
        "finished",
        "cancelled",
        "failed"
      ]
    },
    "MatchView": {
      "type": "object",
      "properties": {
        "algorithm_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deadline_ms": {
          "description": "Срок текущего шага (подтверждение, готовность, сбор кривых), мс Unix.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "end_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "match_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "description": "Режим: «Кто лучше» или «Вместе». Прежние клиенты поле не знают и видят обычную дуэль.",
          "$ref": "#/$defs/MatchMode",
          "default": "versus"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlayerView"
          }
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/MatchResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "room_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "song": {
          "$ref": "#/$defs/SongRef"
        },
        "start_at_ms": {
          "description": "Время старта по часам сервера, мс Unix.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "state": {
          "$ref": "#/$defs/MatchState"
        },
        "turns": {
          "description": "Расписание ходов «Вместе»; у «Кто лучше» пусто и не передаётся.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Turn"
          }
        }
      },
      "required": [
        "match_id",
        "kind",
        "state",
        "song",
        "algorithm_version",
        "players"
      ]
    },
    "Outcome": {
      "type": "string",
      "enum": [
        "win",
        "draw",
        "loss"
      ]
    },
    "PartResult": {
      "type": "object",
      "properties": {
        "hardest": {
          "description": "Самое трудное место партии (окно разбора ядра).",
          "anyOf": [
            {
              "$ref": "#/$defs/HardMoment"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "seconds": {
          "description": "Длительность мелодии эталона в ходах участника, с: вес партии в общем балле.",
          "type": "number",
          "format": "double"
        },
        "slot": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "turns": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "user_id",
        "slot",
        "turns",
        "seconds"
      ]
    },
    "PlayerResult": {
      "type": "object",
      "properties": {
        "axes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Axes"
            },
            {
              "type": "null"
            }
          ]
        },
        "mmr_after": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "mmr_before": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "score": {
          "description": "Канонический балл; null, если кривая неполная (техническое поражение).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "shift": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "standing": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "user_id",
        "outcome"
      ]
    },
    "PlayerView": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        },
        "finished": {
          "type": "boolean"
        },
        "left": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "points": {
          "description": "Сколько точек кривой принято сервером.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ready": {
          "type": "boolean"
        },
        "share_voice": {
          "description": "«Вместе»: участник согласился поделиться голосом с партнёром.",
          "type": "boolean",
          "default": false
        },
        "slot": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "standing": {
          "description": "Ранг или «Калибровка n/10»; MMR соперника не раскрывается.",
          "type": "string"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "slot",
        "user_id",
        "name",
        "standing",
        "accepted",
        "ready",
        "connected",
        "finished",
        "left",
        "points"
      ]
    },
    "QueueState": {
      "type": "object",
      "properties": {
        "match_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "note": {
          "description": "Пояснение для пользователя, например об исчерпанном лимите пары.",
          "type": [
            "string",
            "null"
          ]
        },
        "pool": {
          "type": [
            "string",
            "null"
          ]
        },
        "since_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/QueueStatus"
        },
        "window": {
          "description": "Допустимая разница MMR сейчас (±).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "status"
      ]
    },
    "QueueStatus": {
      "type": "string",
      "enum": [
        "idle",
        "searching",
        "matched"
      ]
    },
    "Reason": {
      "type": "string",
      "enum": [
        "pitch",
        "rhythm",
        "missing"
      ]
    },
    "SongRef": {
      "type": "object",
      "properties": {
        "duration_s": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "duration_s"
      ]
    },
    "TeamResult": {
      "description": "Итог «Вместе»: общий балл — среднее партий, взвешенное по длительности спетой мелодии.",
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartResult"
          }
        },
        "score": {
          "description": "null, если хотя бы одна партия не оценена (неполная кривая).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "parts"
      ]
    },
    "Turn": {
      "description": "Ход режима «Вместе»: участник `slot` поёт с `start_s` до `end_s` (секунды от начала песни,\nокно строки с небольшим запасом) строки текста `lines` (номера в `lyrics` эталона).\nРасписание строит сервер (`coop::schedule`); клиенты его не пересчитывают.",
      "type": "object",
      "properties": {
        "end_s": {
          "type": "number",
          "format": "double"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "slot": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "start_s": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "slot",
        "start_s",
        "end_s",
        "lines"
      ]
    }
  }
}
