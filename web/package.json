{
  "name": "perepev-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite dev --host 127.0.0.1",
    "build": "npm run wasm && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run wasm && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lz-string": "1.5.0",
    "pitchy": "4.1.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "json-schema-to-typescript": "16.0.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.17"
  }
}
