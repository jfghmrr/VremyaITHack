# Необязательные настройки локального запуска. Скопируй в .env при необходимости.
PEREPEV_PORT=8080
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Для свежей локальной базы можно задать собственный пароль (латинские буквы/цифры).
# POSTGRES_PASSWORD=replace_with_your_local_password
# Вход через Яндекс ID и VK ID (docs/oauth-setup.md). Без значений кнопки скрыты.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=
# GPU-обработчик: SHA-256 его токена (printf %s "$TOKEN" | shasum -a 256). Пусто — точная оценка выключена.
# WORKER_TOKEN_SHA256=
# Точная оценка: ожидание итога после конца песни, секунд (меньше 7 минут), и
# сколько исполнений в час принимается с одного адреса.
# PERF_DEADLINE_S=20
# PERF_LIMIT_PER_HOUR=300
