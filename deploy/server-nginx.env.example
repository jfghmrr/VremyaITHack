# Сервер за существующим nginx хоста (OPERATIONS.md, «Сервер за существующим nginx»).
# Скопируй в .env рядом с compose.yaml и закрой от чужих глаз: chmod 600 .env
# Запуск: docker compose -p perepev up -d --build --wait --wait-timeout 180

# Caddy-контейнер слушает только 127.0.0.1:PEREPEV_PORT (так задано в compose.yaml);
# наружу сайт отдаёт nginx хоста: deploy/nginx/perepev.lumnex.ru.conf → 127.0.0.1:8097.
PEREPEV_PORT=8097
APP_ORIGINS=https://perepev.lumnex.ru
PUBLIC_ORIGIN=https://perepev.lumnex.ru
COOKIE_SECURE=true
# TRUST_PROXY=true задан в compose.yaml и не настраивается: API берёт адрес клиента из
# X-Forwarded-For, который Caddy перезаписывает (адрес приходит от nginx).

# Длинный случайный пароль новой базы, только латинские буквы и цифры: openssl rand -hex 32
# Пустое значение не годится: compose.yaml тогда подставит локальный пароль по умолчанию.
POSTGRES_PASSWORD=

# Вход через Яндекс ID и VK ID: регистрация приложений — docs/oauth-setup.md, redirect_uri
# https://perepev.lumnex.ru/api/auth/{yandex,vk}/callback. Пустые значения — кнопки скрыты.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# SHA-256 токена GPU-обработчика (сам токен — только на компьютере обработчика):
#   TOKEN=$(openssl rand -hex 32); printf %s "$TOKEN" | sha256sum
# Пусто — точная оценка выключена, остаётся балл браузера.
WORKER_TOKEN_SHA256=
# Точная оценка: ожидание итога после конца песни, секунд (меньше 7 минут), и
# сколько исполнений в час принимается с одного адреса (на площадке все за одним NAT).
PERF_DEADLINE_S=20
PERF_LIMIT_PER_HOUR=300
