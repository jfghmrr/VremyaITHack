# Домен должен указывать на сервер (A/AAAA-запись), порты 80 и 443 открыты.
SITE_DOMAIN=perepev.example.org
# Длинный случайный пароль базы, например: openssl rand -base64 32
POSTGRES_PASSWORD=
# Вход через Яндекс ID и VK ID: регистрация приложений — docs/oauth-setup.md.
# Пустые значения — кнопки входа скрыты.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# SHA-256 токена GPU-обработчика (сам токен — только на компьютере обработчика):
#   TOKEN=$(openssl rand -hex 32); printf %s "$TOKEN" | sha256sum
WORKER_TOKEN_SHA256=
# Точная оценка: ожидание итога после конца песни, секунд (меньше 7 минут), и
# сколько исполнений в час принимается с одного адреса (на площадке все за одним NAT).
PERF_DEADLINE_S=20
PERF_LIMIT_PER_HOUR=300
